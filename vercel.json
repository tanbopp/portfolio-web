{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "public/index.php", "use": "@vercel/php" },
    { "src": "public/.htaccess", "use": "@vercel/php" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
